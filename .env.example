# URL base de GLPI 10 (sin /apirest.php; se puede cambiar luego en /config sin rebuild).
# Usa la IP interna si hay LAN/VPN, o la pública si vas por internet.
# Requiere API REST habilitada (Setup > General > API).
GLPI_BASE_URL=http://192.168.170.125
# Clave para cifrar client_secret guardado en ./data/config.json (cámbiala, mín 32 chars)
CONFIG_KEY=cambia-esta-clave-de-32-caracteres-minimo-123456
# Password del /config (solo hash en prod; para dev se acepta texto plano si empieza con plain:)
ADMIN_PASSWORD=plain:cambia-esto
PORT=3000
