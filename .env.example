# URL base de GLPI 10 (sin /apirest.php; se puede cambiar luego en /config sin rebuild).
# Usa la IP interna si hay LAN/VPN, o la pública si vas por internet.
# Requiere API REST habilitada (Setup > General > API).
GLPI_BASE_URL=http://192.168.170.125
# Clave para cifrar client_secret guardado en ./data/config.json (cámbiala, mín 32 chars)
CONFIG_KEY=cambia-esta-clave-de-32-caracteres-minimo-123456
# Password admin local (failover si GLPI no responde). Formato plain:... (solo entorno interno)
ADMIN_PASSWORD=plain:cambia-esto
# Perfiles GLPI autorizados a EDITAR (mover bienes, asignar ocupantes). Separados por coma.
# Requieren UPDATE en inventario. Por defecto: Super-Admin,Admin.
GLPI_OPERATOR_PROFILES=Super-Admin,Admin
# Perfiles GLPI con acceso TOTAL (equivale a admin local: config, calibración, backup, logo).
# Por defecto: Super-Admin,Admin.
GLPI_ADMIN_PROFILES=Super-Admin,Admin
PORT=3000
